{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elemental-gaming-nexus",
  "compatibility_date": "2026-07-27",
  "main": "src/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "ARG_DB",
          "database_name": "egn-arg-test",
          "database_id": "PASTE_EGN_ARG_TEST_DATABASE_ID_HERE",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
